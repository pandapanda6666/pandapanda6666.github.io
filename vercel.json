{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, ngrok-skip-browser-warning" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(banners|css|js|images|models|file)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/github/contents",
      "destination": "/api/github/contents"
    },
    {
      "source": "/1-in-10-trillion",
      "destination": "/game/1 in 10 trillion/index.html"
    },
    {
      "source": "/game/1-in-10-trillion",
      "destination": "/game/1 in 10 trillion/index.html"
    },
    {
      "source": "/game/1-in-10-trillion/(.*)",
      "destination": "/game/1 in 10 trillion/$1"
    },
    {
      "source": "/game/1%20in%2010%20trillion",
      "destination": "/game/1 in 10 trillion/index.html"
    },
    {
      "source": "/game/1%20in%2010%20trillion/(.*)",
      "destination": "/game/1 in 10 trillion/$1"
    },
    {
      "source": "/pedia",
      "destination": "/Seeker/Seekerpedia/index.html"
    },
    {
      "source": "/pedia/(.*)",
      "destination": "/Seeker/Seekerpedia/$1"
    },
    {
      "source": "/wiki",
      "destination": "/Seeker/Seekerpedia/index.html"
    },
    {
      "source": "/wiki/(.*)",
      "destination": "/Seeker/Seekerpedia/$1"
    },
    {
      "source": "/Seekerpedia",
      "destination": "/Seeker/Seekerpedia/index.html"
    },
    {
      "source": "/Seekerpedia/(.*)",
      "destination": "/Seeker/Seekerpedia/$1"
    },
    {
      "source": "/shop",
      "destination": "/shop/index.html"
    },
    {
      "source": "/shop/(.*)",
      "destination": "/shop/$1"
    },
    {
      "source": "/game",
      "destination": "/game/index.html"
    },
    {
      "source": "/login-hub",
      "destination": "/login-hub/index.html"
    },
    {
      "source": "/login-hub/(.*)",
      "destination": "/login-hub/$1"
    }
  ]
}
